{
  "name": "chat-over-github",
  "private": true,
  "type": "module",
  "workspaces": [
    "provider",
    "web"
  ],
  "scripts": {
    "typecheck": "npm run typecheck -w provider && npm run typecheck -w web",
    "test": "npm test -w provider && npm test -w web && npm test --prefix worker",
    "build": "npm run build -w web",
    "e2e": "npm run e2e -w web",
    "test:changed": "node scripts/test.mjs",
    "test:all": "node scripts/test.mjs --all"
  },
  "overrides": {
    "ts-mls": {
      "@noble/curves": "2.4.0"
    }
  }
}
