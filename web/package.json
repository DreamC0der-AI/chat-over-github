{
  "name": "chat-over-github-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:mock": "vite build --mode mock --outDir dist-mock",
    "mock-server": "node --experimental-strip-types tools/mock-server.ts",
    "e2e": "npm run build:mock && esbuild tools/mock-server.ts --bundle --platform=node --format=esm --outfile=tools/mock-server.mjs && node tools/e2e-run.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "keyhold": "github:DreamC0der-AI/keyhold#e40c2b7b1de263872a1bf9344245e6815d6c953b",
    "chat-over-github-provider": "0.1.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.9.3",
    "vite": "5.4.11",
    "esbuild": "^0.25.0"
  }
}
