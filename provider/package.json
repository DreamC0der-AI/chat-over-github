{
  "name": "chat-over-github-provider",
  "private": true,
  "version": "0.1.0",
  "description": "GitHub storage provider for keyhold chat: each storage kind as GitHub repos, collaborator access as the channel fence.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:live": "esbuild scripts/live-github.ts --bundle --platform=node --format=esm --outfile=scripts/live-github.mjs"
  },
  "dependencies": {
    "keyhold": "github:DreamC0der-AI/keyhold#62a7e2f2783bc4ba82e7c512ab5d498ed87129aa"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "ts-mls": "1.6.4",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}
